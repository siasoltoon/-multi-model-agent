APP_ENV=development
HOST=0.0.0.0
PORT=8000
# SQLite for local development; use postgresql://... in production
DATABASE_URL=sqlite:///./agent.db
# Optional Redis for distributed task queue/event bus
AGENT_REDIS_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENT_PROVIDER_CATALOGS=
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_API_KEY=
# GitHub Actions dispatch: token needs Actions write permission on the worker repository
AGENT_GITHUB_TOKEN=
AGENT_GITHUB_WORKER_REPOSITORY=
AGENT_GITHUB_WORKER_WORKFLOW=agent-worker.yml
AGENT_GITHUB_WORKER_REF=main
# Public Railway/control-plane URL used by workers to report completion/checkpoints
AGENT_PUBLIC_BASE_URL=
# Callback/worker API authentication
AGENT_GITHUB_CALLBACK_TOKEN=
AGENT_WORKER_AUTH_TOKEN=
AGENT_WORKER_LEASE_SECONDS=300
