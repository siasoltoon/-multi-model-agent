# SQLite for local development; use postgresql://... in production
AGENT_DATABASE_URL=sqlite:///./agent.db
# Optional Redis for distributed task queue/event bus
AGENT_REDIS_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Provider credentials
OPENROUTER_API_KEY=
TOKENHARBOR_API_KEY=
TOKENHARBOR_FREE_MODEL=deepseek-v4.1-flash:free
GROQ_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
AGENT_PROVIDER_CATALOGS=
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_API_KEY=
AGENT_MODEL_REQUEST_TIMEOUT_SECONDS=180
AGENT_MODEL_FAILOVER_ATTEMPTS=3
AGENT_MODEL_RETRY_ATTEMPTS=3
AGENT_MODEL_RETRY_BASE_DELAY_SECONDS=1
AGENT_MODEL_RETRY_MAX_DELAY_SECONDS=30
# Context saver
AGENT_CONTEXT_TARGET_REDUCTION=0.85
AGENT_CONTEXT_KEEP_RECENT=8
AGENT_CONTEXT_MAX_TOOL_CHARS=6000
# GitHub Actions dispatch
AGENT_GITHUB_TOKEN=
AGENT_GITHUB_WORKER_REPOSITORY=
AGENT_GITHUB_WORKER_WORKFLOW=agent-worker.yml
AGENT_GITHUB_WORKER_REF=main
# Public Railway/control-plane URL used by workers
AGENT_PUBLIC_BASE_URL=
# Signed callback authentication; configure the same secret as the worker-repository secret AGENT_CALLBACK_TOKEN
AGENT_GITHUB_CALLBACK_TOKEN=
AGENT_CALLBACK_SIGNATURE_TOLERANCE_SECONDS=300
AGENT_WORKER_AUTH_TOKEN=
AGENT_WORKER_LEASE_SECONDS=300
AGENT_MAX_WORKER_ATTEMPTS=5
