APP_ENV=development
HOST=0.0.0.0
PORT=8000
# SQLite for local development; use postgresql://... in production
DATABASE_URL=sqlite:///./agent.db
# Optional Redis for distributed task queue/event bus
AGENT_REDIS_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Provider credentials: one key can unlock many models; discovery reads provider catalogs automatically.
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
MISTRAL_API_KEY=
AGENT_PROVIDER_CATALOGS=
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_API_KEY=
AGENT_MODEL_REQUEST_TIMEOUT=180
AGENT_MAX_PROVIDER_FAILOVERS=3
# Context saver: compact historical tool output before each model call.
# The default target is 85% reduction of historical tool-output characters.
AGENT_CONTEXT_TARGET_REDUCTION=0.85
AGENT_CONTEXT_KEEP_RECENT=8
AGENT_CONTEXT_MAX_TOOL_CHARS=6000
# GitHub Actions dispatch: token needs Actions write permission on the worker repository
AGENT_GITHUB_TOKEN=
AGENT_GITHUB_WORKER_REPOSITORY=
AGENT_GITHUB_WORKER_WORKFLOW=agent-worker.yml
AGENT_GITHUB_WORKER_REF=main
# Public Railway/control-plane URL used by workers to report completion/checkpoints
AGENT_PUBLIC_BASE_URL=
# Callback/worker API authentication
AGENT_GITHUB_CALLBACK_TOKEN=
AGENT_WORKER_AUTH_TOKEN=
AGENT_WORKER_LEASE_SECONDS=300
